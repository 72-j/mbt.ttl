    NQuadsIri(_) => "Iri"
    NQuadsBlankNode(_) => "BlankNode"
    NQuadsLiteral(_) => "Literal"
    NQuadsDot => "Dot"
    NQuadsPrefName(_) => "PrefName"
    NQuadsUnknown => "Unknown"
