options(
  // js 后端 async/fs 无文件 API(write_file 等)——CLI 工具 native 档,js 独排;
  // wasm/wasm-gc/native 编译面原样(2026-11-03 平台 check js 腿实测修复)
  supported_targets: [ "native", "wasm" ],
)

pkgtype(kind: "executable")

import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "thy1016/moonttl/gen_nquads" @nquads,
}
