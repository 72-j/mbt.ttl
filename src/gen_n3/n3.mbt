      actions.set_subject(ctx, payload)
    }
    (N3ExpectSubject, N3At) => {
      ctx.state = N3ExpectDirectiveKind
      ctx.directive_at = true
      Ok(N3Effect::Continue)
    }
    (N3ExpectSubject, N3PrefixKw) => {
      ctx.state = N3ExpectPrefixName
      ctx.directive_at = false
      Ok(N3Effect::Continue)
    }
    (N3ExpectSubject, N3BaseKw) => {
      ctx.state = N3ExpectBaseIri
      ctx.directive_at = false
      Ok(N3Effect::Continue)
    }
    (N3ExpectSubject, N3VersionKw) => {
      ctx.state = N3ExpectVersionLiteral
      ctx.directive_at = false
      Ok(N3Effect::Continue)
    }
    (N3ExpectSubject, N3TripleTerm(payload)) => {
      ctx.state = N3ExpectVerbOrDot
      actions.set_subject(ctx, payload)
    }
    (N3ExpectPredicate, N3Iri(payload)) => {
      ctx.state = N3ExpectObject
      actions.set_predicate(ctx, payload)
    }
    (N3ExpectPredicate, N3PrefName(payload)) => {
