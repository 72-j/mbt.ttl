///|
/// 原地重置：按 scope 清槽位，未列字段一律保留（粒度语义见 ResetScope）
pub fn N3Context::reset(self : N3Context, scope : ResetScope) -> Unit {
  match scope {
    ResetScope::Object => self.object = None
    ResetScope::PredObj => {
      self.predicate = None
      self.object = None
    }
    ResetScope::SPO => {
      self.subject = None
      self.predicate = None
      self.object = None
    }
    ResetScope::All => {
      self.subject = None
      self.predicate = None
      self.object = None
      self.graph = None
    }
  }
}

