// n3 v2：新一代 N3 解析器（gen_n3v2，ADR-GEN-N3 §5.15 役16）
// n3.mbt = n3gen 自 n3v2_base/n3v2_trans 表对 emit 直产（G9 黄金门钉）；
// 其余 = Assembly 层（种子 = gen_n3 副本，v2 自由演进）；v1 gen_n3 已退役（役19，
// 归档 bak/260910，差分 oracle 史料）——本包为唯一 N3 生产线
// 词法器复用装配层收录的 `lexer_mbt.mbt`（`Token` / `Lexermoon`；Token 与 C 版 Lexerc 同型同宽）

import {
  // "moonbitlang/core/array",
  "moonbitlang/core/encoding/utf8",
  "thy1016/moonttl/gen_nquads" @nquads,
  "thy1016/moonttl/gen_shared" @gs,
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/bench",
} for "wbtest"

options(
  // 后缀系 wbtest 走 @fs 读语料/黄金件——wasm-gc/js 后端 async/fs 无文件 API,
  // 两面摘除;生产面全后端不设限(2026-11-03 平台 check wasm-gc/js 腿实测修复)
  targets: {
    "examples_wbtest.mbt": [ "native", "wasm" ],
    "n3tests_suite_wbtest.mbt": [ "native", "wasm" ],
    "rdf_suite_wbtest.mbt": [ "native", "wasm" ],
  },
)
