// ===== P2 符号响应 mock =====
///|
/// P2 mock: 复用纯模型预测符号响应（本骨架不产生新符号变量）
fn mock_command(
  model : Model,
  command : Command,
  gen_sym : @qcs.GenSym,
) -> (Response, @qcs.GenSym) {
  let (_, response) = model_execute(model, command)
  (response, gen_sym)
}

// ===== P3 响应变量 / 符号解析 / 绑定 =====
///|
/// P3 response_vars: 响应不携带新资源（无新建引用），无变量可提取
fn response_vars(_response : Response) -> Array[@qcs.Var] {
  [] // TODO(P3 人工): 响应携带新资源时在此提取
}
///|
/// 单个引用解析: Concrete 透传，Symbolic 查环境（缺变量报错）
fn reify_ref(
  reference : @qcs.Ref[RefId],
  env : @qcs.Environment[RefId],
) -> Result[@qcs.Ref[RefId], @qcs.EnvError] {
  match reference {
    Concrete(_) => Ok(reference)
    Symbolic(variable) =>
      match env.lookup(variable) {
        Ok(id) => Ok(Concrete(id))
        Err(error) => Err(error)
      }
  }
}
///|
/// P3 reify_command: 逐载荷解析 Symbolic → Concrete
fn reify_command(
  command : Command,
  env : @qcs.Environment[RefId],
) -> Result[Command, @qcs.EnvError] {
  match command {    Iri(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Iri(resolved))
        Err(error) => Err(error)
      }
    BlankNode(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(BlankNode(resolved))
        Err(error) => Err(error)
      }
    Literal(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Literal(resolved))
        Err(error) => Err(error)
      }
    PrefName(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(PrefName(resolved))
        Err(error) => Err(error)
      }
    TripleTerm(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(TripleTerm(resolved))
        Err(error) => Err(error)
      }
    BracketTripleTerm(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(BracketTripleTerm(resolved))
        Err(error) => Err(error)
      }
    KeywordA(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(KeywordA(resolved))
        Err(error) => Err(error)
      }
    Variable(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Variable(resolved))
        Err(error) => Err(error)
      }
    KeywordX(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(KeywordX(resolved))
        Err(error) => Err(error)
      }
    Equals(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Equals(resolved))
        Err(error) => Err(error)
      }
    Is => Ok(Is)
    Of => Ok(Of)
    Has => Ok(Has)
    At => Ok(At)
    PrefixKw => Ok(PrefixKw)
    BaseKw => Ok(BaseKw)
    VersionKw => Ok(VersionKw)
    Tilde => Ok(Tilde)
    AnnotStart => Ok(AnnotStart)
    AnnotEnd => Ok(AnnotEnd)
    ForAllKw => Ok(ForAllKw)
    ForSomeKw => Ok(ForSomeKw)
    KeywordsKw => Ok(KeywordsKw)
    Comma => Ok(Comma)
    Semicolon => Ok(Semicolon)
    Dot => Ok(Dot)
    Lbrace(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Lbrace(resolved))
        Err(error) => Err(error)
      }
    Rbrace => Ok(Rbrace)
    Lbracket(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Lbracket(resolved))
        Err(error) => Err(error)
      }
    Rbracket => Ok(Rbracket)
    Lparen(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Lparen(resolved))
        Err(error) => Err(error)
      }
    Rparen => Ok(Rparen)
    Anon(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Anon(resolved))
        Err(error) => Err(error)
      }
    Bang(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Bang(resolved))
        Err(error) => Err(error)
      }
    Caret(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Caret(resolved))
        Err(error) => Err(error)
      }
    Implies(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Implies(resolved))
        Err(error) => Err(error)
      }
    ImpliedBy(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(ImpliedBy(resolved))
        Err(error) => Err(error)
      }
    Unknown(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(Unknown(resolved))
        Err(error) => Err(error)
      }
    Id => Ok(Id)
    Invert => Ok(Invert)
    EOF => Ok(EOF)
  }
}
