// ===== P2 引用取值与权重 =====
///|
/// 引用取值范围（源 [business].ref_id_range）：越小越利于 shrink 收敛
const REF_ID_RANGE : Int = 8
///|
/// 命令权重（源 [business].weights；未声明默认 1，0 表示禁用）。
/// 权重只影响选择概率，合法性仍由 valid 过滤（转移表是唯一权威）。
/// 沿革（R-18 再生笔，2026-09-18）：本表是**手编层**——再生模板只发空表 `_ => 1`，
/// 再生后须照 `src/quick_machine/quick_machine_n3.toml` 的 [business.weights] 重铺
///（役 9 候选：模板按业务 TOML 发表）。笔 3a 再生后再铺（表未变，Id/Invert = 0 保持）。
fn command_weight(name : String) -> Int {
  match name {
    "At" => 1
    "Is" => 0
    "Of" => 0
    "Dot" => 3
    "EOF" => 0
    "Has" => 0
    "Iri" => 3
    "Anon" => 0
    "Bang" => 0
    "Caret" => 0
    "Comma" => 1
    "Tilde" => 1
    "BaseKw" => 1
    "Equals" => 1
    "Lbrace" => 0
    "Lparen" => 0
    "Rbrace" => 0
    "Rparen" => 0
    "Implies" => 0
    "Literal" => 3
    "Unknown" => 0
    "AnnotEnd" => 0
    "ForAllKw" => 0
    "KeywordA" => 0
    "KeywordX" => 0
    "Lbracket" => 0
    "PrefName" => 2
    "PrefixKw" => 1
    "Rbracket" => 0
    "Variable" => 0
    "BlankNode" => 2
    "ForSomeKw" => 0
    "ImpliedBy" => 0
    "Semicolon" => 1
    "VersionKw" => 0
    "AnnotStart" => 0
    "KeywordsKw" => 0
    "TripleTerm" => 0
    "BracketTripleTerm" => 0
    "Id" => 0
    "Invert" => 0
    _ => 1
  }
}
///|
/// 新引用：取值模 REF_ID_RANGE（有限取值空间利于失败复现）
fn fresh_ref(rng : @splitmix.RandomState) -> @qcs.Ref[RefId] {
  Concrete({ id: rng.next_positive_int() % REF_ID_RANGE })
}
///|
/// P2 generator: 候选全构造 → valid 过滤 → 权重抽取（无合法候选返回 None）
///
/// **size 口径**：本骨架的 size 不参与分布——合法性由转移表决定、序列收缩由 P4
/// 负责；生成器若将来要"按 size 收束"，接在这里。
fn generate_command(
  model : Model,
  size : Int,
  rng : @splitmix.RandomState,
) -> Command? {
  ignore(size)
  let candidates : Array[Command] = [
    Iri(fresh_ref(rng)),
    BlankNode(fresh_ref(rng)),
    Literal(fresh_ref(rng)),
    PrefName(fresh_ref(rng)),
    TripleTerm(fresh_ref(rng)),
    BracketTripleTerm(fresh_ref(rng)),
    KeywordA(fresh_ref(rng)),
    Variable(fresh_ref(rng)),
    KeywordX(fresh_ref(rng)),
    Equals(fresh_ref(rng)),
    Is,
    Of,
    Has,
    At,
    PrefixKw,
    BaseKw,
    VersionKw,
    Tilde,
    AnnotStart,
    AnnotEnd,
    ForAllKw,
    ForSomeKw,
    KeywordsKw,
    Comma,
    Semicolon,
    Dot,
    Lbrace(fresh_ref(rng)),
    Rbrace,
    Lbracket(fresh_ref(rng)),
    Rbracket,
    Lparen(fresh_ref(rng)),
    Rparen,
    Anon(fresh_ref(rng)),
    Bang(fresh_ref(rng)),
    Caret(fresh_ref(rng)),
    Implies(fresh_ref(rng)),
    ImpliedBy(fresh_ref(rng)),
    Unknown(fresh_ref(rng)),
    Id,
    Invert,
    EOF,
  ]
  let names : Array[String] = [
    "Iri",
    "BlankNode",
    "Literal",
    "PrefName",
    "TripleTerm",
    "BracketTripleTerm",
    "KeywordA",
    "Variable",
    "KeywordX",
    "Equals",
    "Is",
    "Of",
    "Has",
    "At",
    "PrefixKw",
    "BaseKw",
    "VersionKw",
    "Tilde",
    "AnnotStart",
    "AnnotEnd",
    "ForAllKw",
    "ForSomeKw",
    "KeywordsKw",
    "Comma",
    "Semicolon",
    "Dot",
    "Lbrace",
    "Rbrace",
    "Lbracket",
    "Rbracket",
    "Lparen",
    "Rparen",
    "Anon",
    "Bang",
    "Caret",
    "Implies",
    "ImpliedBy",
    "Unknown",
    "Id",
    "Invert",
    "EOF",
  ]
  let weighted : Array[(Command, Int)] = []
  for index = 0; index < candidates.length(); index = index + 1 {
    let command = candidates[index]
    if valid(model, command) {
      let weight = command_weight(names[index])
      if weight > 0 {
        weighted.push((command, weight))
      }
    }
  }
  let mut total = 0
  for entry in weighted {
    total = total + entry.1
  }
  if total == 0 {
    return None // 无合法候选：交给 qcs 判 Deadlock
  }
  let mut pick = rng.next_positive_int() % total
  for entry in weighted {
    if pick < entry.1 {
      return Some(entry.0)
    }
    pick = pick - entry.1
  }
  None
}
