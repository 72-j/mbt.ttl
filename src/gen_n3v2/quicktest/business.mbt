// ===== P4 收缩 / 重映射 =====
///|
/// P4 remap_command: 命令无符号变量引用，恒可保留
fn remap_command(
  command : Command,
  _scope : Map[@qcs.Var, @qcs.Var],
) -> Command? {
  Some(command) // TODO(P4 人工): 命令引用响应变量时按 scope 重映射
}
///|
/// 引用收缩候选：id 减半、归零（取值空间有限，越小越易读）
fn shrink_ref(reference : @qcs.Ref[RefId]) -> Array[@qcs.Ref[RefId]] {
  match reference {
    Concrete(id) if id.id > 0 =>
      [Concrete({ id: id.id / 2 }), Concrete({ id: 0 })]
    _ => []
  }
}
///|
/// P4 shrink_command: 只收缩引用载荷；结构命令本身已是最简
fn shrink_command(_model : Model, command : Command) -> Array[Command] {
  match command {    Iri(reference) =>
      shrink_ref(reference).map(fn(smaller) { Iri(smaller) })
    BlankNode(reference) =>
      shrink_ref(reference).map(fn(smaller) { BlankNode(smaller) })
    Literal(reference) =>
      shrink_ref(reference).map(fn(smaller) { Literal(smaller) })
    PrefName(reference) =>
      shrink_ref(reference).map(fn(smaller) { PrefName(smaller) })
    TripleTerm(reference) =>
      shrink_ref(reference).map(fn(smaller) { TripleTerm(smaller) })
    BracketTripleTerm(reference) =>
      shrink_ref(reference).map(fn(smaller) { BracketTripleTerm(smaller) })
    KeywordA(reference) =>
      shrink_ref(reference).map(fn(smaller) { KeywordA(smaller) })
    Variable(reference) =>
      shrink_ref(reference).map(fn(smaller) { Variable(smaller) })
    KeywordX(reference) =>
      shrink_ref(reference).map(fn(smaller) { KeywordX(smaller) })
    Equals(reference) =>
      shrink_ref(reference).map(fn(smaller) { Equals(smaller) })
    Lbrace(reference) =>
      shrink_ref(reference).map(fn(smaller) { Lbrace(smaller) })
    Lbracket(reference) =>
      shrink_ref(reference).map(fn(smaller) { Lbracket(smaller) })
    Lparen(reference) =>
      shrink_ref(reference).map(fn(smaller) { Lparen(smaller) })
    Anon(reference) =>
      shrink_ref(reference).map(fn(smaller) { Anon(smaller) })
    Bang(reference) =>
      shrink_ref(reference).map(fn(smaller) { Bang(smaller) })
    Caret(reference) =>
      shrink_ref(reference).map(fn(smaller) { Caret(smaller) })
    Implies(reference) =>
      shrink_ref(reference).map(fn(smaller) { Implies(smaller) })
    ImpliedBy(reference) =>
      shrink_ref(reference).map(fn(smaller) { ImpliedBy(smaller) })
    Unknown(reference) =>
      shrink_ref(reference).map(fn(smaller) { Unknown(smaller) })
    _ => []
  }
}

// ===== P5 后置条件与不变量 =====
///|
/// P5 postcondition: 严格双执行比较（含错误码）——宁可误报，不可漏报
fn postcondition(
  model : Model,
  command : Command,
  response : Response,
) -> @qcs.Logic {
  let (_, expected) = model_execute(model, command)
  @qcs.Logic::predicate(
    name="model matches system",
    value=expected == response,
  )
}
///|
/// P5 invariant: 模型不变量（保守恒真；槽位一致性等业务性质在此补）
fn model_invariant(_model : Model) -> @qcs.Logic {
  @qcs.Logic::top() // TODO(P5 人工): 模型不变量（如槽位一致性）
}

///|
test "n3_quick_machine business: 权重与收缩候选冒烟" {
  assert_true(REF_ID_RANGE > 0)
  assert_true(command_weight("Iri") > 0)
  assert_eq(shrink_command(model_empty(), Iri(Concrete({ id: 4 }))), [
    Iri(Concrete({ id: 2 })),
    Iri(Concrete({ id: 0 })),
  ])}
