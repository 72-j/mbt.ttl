///|
/// 固定脚本检查（P5.4 接活）：回归基线——单三元组 + BnP 嵌套块（表侧唯一 Sequence 行）
test "n3 quick machine: assert check（固定脚本）" {
  let report = run_assert_check()
  assert_eq(report.commands_run, 11)
}

///|
/// 随机属性测试（MVP 口径）：权重片 = 三元脊柱 + BnP 帧 + 公式帧 + 注解 + 指令 +
/// `~`/`=`/is-of 简行；路径/集合/Id/Invert 切片零权重（缺口台账 todo.md §6）
test "n3 quick machine: random check（模型 ≡ 引擎）" {
  match run_random_check() {
    Ok(report) => assert_eq(report.cases_run, 100)
    Err(failure) =>
      fail(
        "随机检查失败（模型与引擎漂移）: \{@qcs.format_failure(failure)}",
      )
  }
}
