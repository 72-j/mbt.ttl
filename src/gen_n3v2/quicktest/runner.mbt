///|
fn quick_run_config() -> @qcs.RunConfig {
  {
    seed: 12345UL,
    cases: 100,
    max_commands: 20,
    size: 20,
    max_tries: 20,
    shrink: true,
    max_shrinks: 100,
    max_shrink_rounds: 20,
    required_labels: [],
    required_command_names: [],
  }
}

// ===== 固定脚本（源: [[assert_check]], 11 步） =====

///|
fn assert_script() -> Array[Command] {
  [
    Iri(Concrete({ id: 0, })),
    Iri(Concrete({ id: 4, })),
    Iri(Concrete({ id: 8, })),
    Dot,
    Iri(Concrete({ id: 20, })),
    Iri(Concrete({ id: 24, })),
    Lbracket(Concrete({ id: 28, })),
    PrefName(Concrete({ id: 31, })),
    Iri(Concrete({ id: 34, })),
    Rbracket,
    Dot,
  ]
}

///|
/// 固定脚本检查: 失败即抛出（回归基准; 覆盖关键路径）
fn run_assert_check() -> @qcs.RunReport[Command, Response, Command, Response] raise {
  let script = assert_script()
  let config = { ..quick_run_config(), cases: 1, max_commands: 11, }
  @qcs.assert_check(quick_state_machine(script=Some(script)), config~)
}
