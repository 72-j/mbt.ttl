// ========================================
// StateMachine - 状态机组装 — Generated by QuickMachine Code Generator
// FSM: n3_parser | Config: n3_quick_machine
// Generated at: 1789800000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// ========================================
// B 式（直接引用）: 业务函数来自 business.mbt, 组装点唯一;
// system_call 可替换 —— 反例注入（验证机器真能发现系统漂移）
// script 模式提供游标生成器, 供 run_assert_check 固定脚本复用同一组装

///|
/// 命令名（覆盖率报告用, 源 [[events]]）
fn command_name(command : Command) -> String {
  match command {
    Iri(_) => "Iri"
    BlankNode(_) => "BlankNode"
    Literal(_) => "Literal"
    PrefName(_) => "PrefName"
    TripleTerm(_) => "TripleTerm"
    BracketTripleTerm(_) => "BracketTripleTerm"
    KeywordA(_) => "KeywordA"
    Variable(_) => "Variable"
    KeywordX(_) => "KeywordX"
    Equals(_) => "Equals"
    Is => "Is"
    Of => "Of"
    Has => "Has"
    At => "At"
    PrefixKw => "PrefixKw"
    BaseKw => "BaseKw"
    VersionKw => "VersionKw"
    Tilde => "Tilde"
    AnnotStart => "AnnotStart"
    AnnotEnd => "AnnotEnd"
    ForAllKw => "ForAllKw"
    ForSomeKw => "ForSomeKw"
    KeywordsKw => "KeywordsKw"
    Comma => "Comma"
    Semicolon => "Semicolon"
    Dot => "Dot"
    Lbrace(_) => "Lbrace"
    Rbrace => "Rbrace"
    Lbracket(_) => "Lbracket"
    Rbracket => "Rbracket"
    Lparen(_) => "Lparen"
    Rparen => "Rparen"
    Anon(_) => "Anon"
    Bang(_) => "Bang"
    Caret(_) => "Caret"
    Implies(_) => "Implies"
    ImpliedBy(_) => "ImpliedBy"
    Unknown(_) => "Unknown"
    EOF => "EOF"
  }
}

///|
/// 组装状态机（B 式直接引用）: 业务函数来自 business.mbt;
/// system_call 可替换 —— 反例注入（验证机器真能发现系统漂移）
fn quick_state_machine(
  system_call? : (Command, System) -> Response = run_command,
  script? : Array[Command]? = None,
) -> @qcs.StateMachine[
  Model,
  Model,
  Command,
  Command,
  Response,
  Response,
  RefId,
  System,
] {
  let cursor : Array[Int] = [0]
  @qcs.StateMachine::new(
    init_symbolic_model=model_empty,
    init_concrete_model=model_empty,
    init_system=() => system_init(),
    generator=(model, size, rng) => {
      match script {
        Some(commands) => {
          let index = cursor[0]
          if index < commands.length() {
            cursor[0] = index + 1
            Some(commands[index])
          } else {
            None
          }
        }
        None => generate_command(model, size, rng)
      }
    },
    mock=mock_command,
    transition_symbolic=transition,
    transition_concrete=transition,
    precondition~,
    postcondition~,
    invariant=model_invariant,
    response_vars~,
    shrinker=shrink_command,
    remap_command~,
    reify_command~,
    run_command=(command, system) => system_call(command, system),
    bind_response~,
    cleanup=(_model, _system) => (),
    label=(_model, _command, response) => {
      match response {
        Continue => ["resp:Continue"]
        EmitQuad(_) => ["resp:EmitQuad"]
        Done => ["resp:Done"]
        Error(_) => ["resp:error"]
        // P4.2h ③ 同款（trig 先例）：有序批按**批内每一枚**打标签（单枚仍是 resp:EmitQuad）
        Batch(items) =>
          items.map(fn(item) {
            match item {
              Continue => "resp:Continue"
              EmitQuad(_) => "resp:EmitQuad"
              Done => "resp:Done"
              Error(_) => "resp:error"
              Batch(_) => "resp:batch"
            }
          })
      }
    },
    command_name~,
  )
}

///|
test "n3_quick_machine state_machine: 组装冒烟" {
  // 组装冒烟: 默认回调与脚本模式可构建（回调接线正确性由编译器保证）
  let sm = quick_state_machine()
  ignore(sm)
  let scripted = quick_state_machine(script=Some([Is]))
  ignore(scripted)
  assert_eq(command_name(Is), "Is")
}
