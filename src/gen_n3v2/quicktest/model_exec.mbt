    (FormulaAfterObject, Comma) =>
      ({ ..model, state: FormulaExpectObject, object: None, }, Continue)
    // @arm FormulaAfterObject+Semicolon
    (FormulaAfterObject, Semicolon) =>
      (
        {
          ..model,
          state: FormulaExpectPredicate,
          predicate: None,
          object: None,
        },
        Continue,
      )
    // --- AnnotExpectEnd ---
    // @arm AnnotExpectEnd+Comma
    (AnnotExpectEnd, Comma) => emit_object(model, AnnotExpectObject)
    // @arm AnnotExpectEnd+Semicolon
    (AnnotExpectEnd, Semicolon) => emit_predobj(model, AnnotExpectVerbTail)
    // @arm AnnotExpectEnd+AnnotEnd
    (AnnotExpectEnd, AnnotEnd) => emit_predobj(model, ExpectVerbOrEnd)
    // --- ExpectTildeEnd ---
    // @arm ExpectTildeEnd+Iri
    (ExpectTildeEnd, Iri(_)) => (model, Continue) // TODO(P0): 未识别 action none，默认响应请人工确认
    // @arm ExpectTildeEnd+PrefName
    (ExpectTildeEnd, PrefName(_)) => (model, Continue) // TODO(P0): 未识别 action none，默认响应请人工确认
    // @arm ExpectTildeEnd+BlankNode
    (ExpectTildeEnd, BlankNode(_)) => (model, Continue) // TODO(P0): 未识别 action none，默认响应请人工确认
    // @arm ExpectTildeEnd+Dot
    (ExpectTildeEnd, Dot) => emit_spo(model, ExpectSubject)
    // @arm ExpectTildeEnd+Semicolon
    (ExpectTildeEnd, Semicolon) => emit_predobj(model, ExpectVerbOrEnd)
    // @arm ExpectTildeEnd+Comma
    (ExpectTildeEnd, Comma) => emit_object(model, ExpectObject)
    // @arm ExpectTildeEnd+AnnotStart
    (ExpectTildeEnd, AnnotStart) => emit_predobj(model, AnnotExpectVerb)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 槽位更新辅助: subject（action set_subject）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_subject(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let subject = match ref_id(r) {
    Some(id) => Some(id)
    None => model.subject
  }
  { ..model, state: to, subject, }
}

///|
/// 槽位更新辅助: predicate（action set_predicate）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_predicate(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let predicate = match ref_id(r) {
    Some(id) => Some(id)
    None => model.predicate
  }
  { ..model, state: to, predicate, }
}

///|
/// 槽位更新辅助: object（action set_object）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_object(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let object = match ref_id(r) {
    Some(id) => Some(id)
    None => model.object
  }
  { ..model, state: to, object, }
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 Object 清槽
/// 罩内压制（笔 3c）：任一帧 `is_formula` 为真 ⇒ 只收拾不上抛（ADR-002），
/// 与引擎 `under_formula()` 同口径；倒装结算照常（take_pending 副作用全跑）。
fn emit_object(model : Model, to : ModelState) -> (Model, Response) {
  if model.frames.any(fn(frame) { frame.is_formula }) {
    (inversion_settle({ ..model, state: to, object: None, }, true), Continue)
  } else {
    let quad = inversion_swap(model, take_quad(model))
    (
      inversion_settle({ ..model, state: to, object: None, }, true),
      EmitQuad(quad),
    )
  }
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 PredObj 清槽
/// 罩内压制（笔 3c）：任一帧 `is_formula` 为真 ⇒ 只收拾不上抛（ADR-002），
/// 与引擎 `under_formula()` 同口径；倒装结算照常（take_pending 副作用全跑）。
fn emit_predobj(model : Model, to : ModelState) -> (Model, Response) {
  if model.frames.any(fn(frame) { frame.is_formula }) {
    (
      inversion_settle(
        { ..model, state: to, predicate: None, object: None, },
        false,
      ),
      Continue,
    )
  } else {
    let quad = inversion_swap(model, take_quad(model))
    (
      inversion_settle(
        { ..model, state: to, predicate: None, object: None, },
        false,
      ),
      EmitQuad(quad),
    )
  }
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 SPO 清槽
/// 罩内压制（笔 3c）：任一帧 `is_formula` 为真 ⇒ 只收拾不上抛（ADR-002），
/// 与引擎 `under_formula()` 同口径；倒装结算照常（take_pending 副作用全跑）。
fn emit_spo(model : Model, to : ModelState) -> (Model, Response) {
  if model.frames.any(fn(frame) { frame.is_formula }) {
    (
      inversion_settle(
        { ..model, state: to, subject: None, predicate: None, object: None, },
        false,
      ),
      Continue,
    )
  } else {
    let quad = inversion_swap(model, take_quad(model))
    (
      inversion_settle(
        { ..model, state: to, subject: None, predicate: None, object: None, },
        false,
      ),
      EmitQuad(quad),
    )
  }
}

///|
/// 倒装交换：is_src 在册且四元组主语与之同值（键 = span 身份，
/// 嵌套 fresh 主语错键不换——引擎 take_pending 同口径）
fn inversion_swap(model : Model, quad : Quad) -> Quad {
  match model.is_src {
    Some(src) =>
      if quad.subject == Some(src) {
        { ..quad, subject: quad.object, object: quad.subject, }
      } else {
        quad
      }
    None => quad
  }
}

///|
/// 倒装结算：scope 非 Object 且栈深回到 is_depth 记录位 ⇒ 清 is_src
/// （Comma Object 保键连换；嵌套内层发射深度不齐保键——settle_inversion 同口径）
fn inversion_settle(model : Model, object_scope : Bool) -> Model {
  if !object_scope && model.frames.length() == model.is_depth {
    { ..model, is_src: None, }
  } else {
    model
  }
}

///|
/// 压帧（P4.2e）：记外层三槽快照 + `open_span` + `ret_state` + `as_subject`，
/// 再把 `subject = open_span`、`predicate = None`（与引擎 open_bnode_prop/open_collection 同机械）；
/// 例外（族 A，R-20）：`is_formula` 位在册时公式帧**不占** s 槽（引擎 open_formula
/// 是 s/p 双清——Bnp 占 s 槽与公式清 s 的语义分野），生成按位分派的表达式
fn frame_push(
  model : Model,
  open : @qcs.Ref[RefId],
  ret_state : ModelState,
  as_subject : Bool,
  to : ModelState,
  f0 : Bool,
  f1 : Bool,
) -> Model {
  // 符号期无具体值 ⇒ 哨兵 RefId(0)（结构期只需"有节点"；执行期解析真值）
  let open_span = match ref_id(open) {
    Some(id) => id
    None => { id: 0, }
  }
  let frames = model.frames.copy()
  frames.push({
    subject: model.subject,
    predicate: model.predicate,
    graph: model.graph,
    open_span,
    ret_state,
    as_subject,
    prev_node: None,
    is_formula: f0,
    as_pred: f1,
  })
  // 状态由**转移表**给（`to`）；`ret_state` 只是压进帧、弹帧时才兑现
  {
    ..model,
    state: to,
    subject: if f0 {
      None
    } else {
      Some(open_span)
    },
    predicate: None,
    frames,
  }
}

///|
/// 弹帧（P4.2e）：恢复外层三槽 + **`state = ret_state`**（"状态由表管理"的唯一例外，
/// 引擎在 pop_bnode_prop 尾行兑现）；新节点引用取 `open_span`
/// （空表 `(open.0, 0)` 与 `open_span` 同 start ⇒ 同 RefId，故模型无需建链）。
fn frame_pop(model : Model) -> Model {
  // 纯函数口径：先 copy 再 pop——模型执行可能被调用两次（`transition` 会重跑
  let frames = model.frames.copy()
  match frames.pop() {
    Some(fr) => {
      let target = fr.open_span
      // 弹帧回写（笔 3c 下半·三）：谓位帧弹帧把占位回写谓词槽（引擎 pop 尾行同机械）。
      if fr.as_pred {
        return {
          ..model,
          state: fr.ret_state,
          subject: fr.subject,
          predicate: Some(target),
          object: model.object,
          graph: fr.graph,
          frames,
        }
      }
      let subject = if fr.as_subject { Some(target) } else { fr.subject }
      let object = if fr.as_subject { model.object } else { Some(target) }
      {
        ..model,
        state: fr.ret_state,
        subject,
        predicate: fr.predicate,
        object,
        graph: fr.graph,
        frames,
      }
    }
    None => model
  }
}

///|
/// 帧栈顶 `prev_node` 读助手（笔 3b 起；笔 3c 支持带类型帧位）：**被读**时生成。
/// 空栈兜底 = `None`（与该位的声明类型一致）。
fn frame_prev_node(model : Model) -> RefId? {
  match model.frames.length() {
    0 => None
    _ => model.frames[model.frames.length() - 1].prev_node
  }
}

///|
/// 帧顶写助手（笔 3a 起；笔 3b 改为按声明字段逐支发射）：`frame.prev_node=<来源>` 声明时生成。
fn frames_top_set_prev_node(
  frames : Array[Frame],
  prev_node : RefId?,
) -> Array[Frame] {
  let frames = frames.copy()
  if frames.length() > 0 {
    frames[frames.length() - 1] = { ..frames[frames.length() - 1], prev_node, }
  }
  frames
}

///|
/// 帧顶写助手（笔 3a 起；笔 3b 改为按声明字段逐支发射）：`frame.ret_state=<来源>` 声明时生成。
fn frames_top_set_ret_state(
  frames : Array[Frame],
  ret_state : ModelState,
) -> Array[Frame] {
  let frames = frames.copy()
  if frames.length() > 0 {
    frames[frames.length() - 1] = { ..frames[frames.length() - 1], ret_state, }
  }
  frames
}

///|
/// 帧顶写助手（笔 3a 起；笔 3b 改为按声明字段逐支发射）：`frame.open_span=<来源>` 声明时生成。
fn frames_top_set_open_span(
  frames : Array[Frame],
  open_span : RefId,
) -> Array[Frame] {
  let frames = frames.copy()
  if frames.length() > 0 {
    frames[frames.length() - 1] = { ..frames[frames.length() - 1], open_span, }
  }
  frames
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 恒按模型自臂推进：建模错误臂（旗拒/值支）自报拒绝态（引擎 Err 后净态 =
/// row.to）；catch-all/守卫错误臂 .0 = model，冻结语义不变
fn transition(model : Model, command : Command, response : Response) -> Model {
  ignore(response)
  model_execute(model, command).0
}

///|
test "n3_quick_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(
    m,
    BracketTripleTerm(Concrete({ id: 1, })),
  )
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, BracketTripleTerm(Concrete({ id: 1, })), Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Iri(Concrete({ id: 1, })), Continue)
  assert_true(t_ok != m)
}

///|
test "n3_quick_machine model_exec: EmitQuad 发射路径与空槽照发" {
  // 快照档（ADR-QM-009）：槽位不全也照发 —— 载荷 = 引擎发射边界的槽位快照
  let ready = {
    ..model_empty(),
    state: ExpectDotOrGraph,
    subject: Some({ id: 1, }),
    predicate: Some({ id: 2, }),
    object: Some({ id: 3, }),
    graph: Some({ id: 4, }),
    path_src: Some({ id: 5, }),
    path_pend: Some({ id: 6, }),
    path_tail: Some({ id: 7, }),
  }
  let (m1, r1) = model_execute(ready, AnnotStart)
  assert_true(r1 is EmitQuad(_))
  assert_true(m1.predicate is None) // scope 清槽
  assert_true(m1.object is None) // scope 清槽
  // 空槽快照：仍发 EmitQuad（不设"槽位齐全"前置），状态照常推进
  let empty = { ..model_empty(), state: ExpectDotOrGraph, }
  let (m2, r2) = model_execute(empty, AnnotStart)
  assert_true(r2 is EmitQuad(_))
  assert_eq(m2.state, AnnotExpectVerb)
}
