pub fn[TR, RR] Parser::for_reader(Self[TR, RR], &@io.Reader) -> ReaderIterator[TR, RR]
pub fn[TR, RR] Parser::is_end(Self[TR, RR]) -> Bool
pub fn[TR : TokenRecognizer, RR : RuleRecognizer] Parser::parse_next(Self[TR, RR]) -> Result[RdfOut, TurtleError]?

pub struct ParserM[TR, M] {
  lexer : Lexer[TR]
  mut engine : GenericStateMachine[M]
  context : RdfContext
  errors : Array[RuleRecognizerError]
}
pub fn[TR, M] ParserM::ParserM(Lexer[TR], GenericStateMachine[M], RdfContext) -> Self[TR, M]
pub fn[TR, M] ParserM::end(Self[TR, M]) -> Bool
pub fn[TR, M : StateMachine] ParserM::is_end(Self[TR, M]) -> Bool
pub fn[TR : TokenRecognizer, M : StateMachine + RuleRecognizer] ParserM::parse_next(Self[TR, M]) -> Result[RdfOut, TurtleError]?

