// Type aliases
pub using @ref {type Ref}

pub type TransitionResult[TR, S, O] = Result[(TR, S, O?), RuleRecognizerError]

// Traits
pub trait DebugLogger {
  fn info(Self, String) -> Unit
  fn error(Self, String) -> Unit
  fn warn(Self, String) -> Unit
}

pub trait ErrOut {
  fn message(Self) -> String
  fn err_kind(Self) -> String
}

pub trait IriComponents {
  fn query(Self) -> String?
  fn is_absolute(Self) -> Bool
  fn scheme(Self) -> String?
  fn authority(Self) -> String?
  fn path(Self) -> String?
  fn fragment(Self) -> String?
}

pub trait RuleRecognizer {
  fn error_recovery_state(Self) -> Self
  fn recognize_next(Self, LocatedTokenOrLineJump, RdfContext, Array[RdfOut]) -> Self
  fn recognize_end(Self, RdfContext, Array[RdfOut]) -> Unit
  fn lexer_options(RdfContext) -> LexerOptions?
  fn[DL : DebugLogger] debug_logger(Self, DL) -> Unit
}

pub trait StateMachine {
  fn initial_state(Self) -> RdfState
  fn transition(Self, RdfState, LocatedTokenOrLineJump, RdfContext) -> Result[(Self, RdfState, RdfOut?), RuleRecognizerError]
  fn current_state(Self) -> RdfState
  fn step(Self, LocatedTokenOrLineJump) -> Self
  fn reset(Self) -> Self
  fn is_accepting(Self) -> Bool
  fn context(Self) -> RdfContext
  fn set_context(Self, RdfContext) -> Self
  fn[ST : StateWrapper] set_current_state(Self, ST) -> Self
  fn error_recovery_statemachine(Self) -> Self
}

pub trait StateWrapper {
  fn as_state_enum(Self) -> RdfState
}

trait StringRepr

pub trait TokenRecognizer {
  fn recognize_next_token(Self, ArrayView[Byte], Bool, LexerOptions?, SourcePos) -> (Int, Result[LocatedTokenOrLineJump, TokenRecognizerError])?
}

