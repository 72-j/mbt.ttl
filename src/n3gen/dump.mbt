// n3gen 发射面：IR 兼容 n3_fsm.toml 逐字节复刻
// 格式权威 = 外层 src/rdf/toml_gen.mbt 各 emit_* + compile_domain_to_fsm_toml 拼装序
// 横幅文字（含 "# Generated by domain_to_ir.mbt"）为钉死残迹：byte 对拍口径所需，
// v1 保留（v2 直落 n3.mbt 时随 dump 段一起退役）

///|
fn n3_rule() -> String {
  "# =========================================================="
}

///|
/// IR 三行横幅
fn n3_banner3(title : String) -> String {
  "\{n3_rule()}\n\{title}\n\{n3_rule()}"
}

///|
fn n3_dump_meta(base : N3BaseDef) -> String {
  let buf = StringBuilder()
  buf.write_string("\{n3_rule()}\n")
  buf.write_string("# Generated by domain_to_ir.mbt\n")
  buf.write_string("\{n3_rule()}\n\n")
  buf.write_string("[meta]\n")
  buf.write_string("name = \"\{base.meta_name}\"\n")
  buf.write_string("dialect = \"\{base.meta_dialect}\"\n")
  buf.write_string("version = \"\{base.meta_version}\"\n")
  buf.write_string("prefix = \"\{base.meta_prefix}\"\n")
  buf.write_string("trait_name = \"\{base.meta_trait}\"\n")
  buf.write_string("style = \"\{base.meta_style}\"\n\n")
  buf.to_string()
}

///|
fn n3_dump_dialect(base : N3BaseDef) -> String {
  if base.capabilities.is_empty() && base.enums.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\n[dialect.\{base.meta_dialect}]\n")
  buf.write_string("capabilities = [")
  for i, c in base.capabilities {
    if i > 0 {
      buf.write_string(", ")
    }
    buf.write_string("\"\{c}\"")
  }
  buf.write_string("]\n")
  for e in base.enums {
    buf.write_string("\n[[dialect.\{base.meta_dialect}.enums]]\n")
    buf.write_string("name = \"\{e.name}\"\n")
    match e.doc {
      Some(d) => buf.write_string("doc = \"\{d}\"\n")
      None => ()
    }
    buf.write_string("variants = [")
    for i, v in e.variants {
      if i > 0 {
        buf.write_string(", ")
      }
      buf.write_string("\"\{v}\"")
    }
    buf.write_string("]\n")
    if e.emit == false {
      buf.write_string("emit = false\n")
    }
  }
  buf.to_string()
}


///|
fn n3_dump_events(events : Array[N3EventDef]) -> String {
  if events.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\{n3_banner3("# 4. 事件定义（Events）")}\n")
  for e in events {
    buf.write_string("\n[[events]]\n")
    buf.write_string("name = \"\{e.name}\"\n")
    if e.payload.is_empty() == false {
      buf.write_string("payload = [")
      for j, f in e.payload {
        if j > 0 {
          buf.write_string(", ")
        }
        buf.write_string("{ name = \"\{f.0}\", type = \"\{f.1}\" }")
      }
      buf.write_string("]\n")
    }
  }
  buf.to_string()
}

///|
fn n3_dump_states(states : Array[N3StateDef]) -> String {
  if states.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\{n3_banner3("# 3. 状态定义（States）")}\n")
  for s in states {
    buf.write_string("\n[[states]]\n")
    buf.write_string("name = \"\{s.name}\"\n")
    if s.is_initial {
      buf.write_string("is_initial = true\n")
    }
  }
  buf.to_string()
}

///|
fn n3_dump_effects(effects : Array[N3EffectDef]) -> String {
  if effects.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\{n3_banner3("# 8. Effect 定义（Effects）")}\n")
  for e in effects {
    buf.write_string("\n[[effects]]\n")
    buf.write_string("name = \"\{e.name}\"\n")
    match e.semantics {
      Some(s) => buf.write_string("semantics = \"\{s}\"\n")
      None => ()
    }
    if e.payload.is_empty() == false {
      buf.write_string("payload = [")
      for j, f in e.payload {
        if j > 0 {
          buf.write_string(", ")
        }
        buf.write_string("{ name = \"\{f.0}\", type = \"\{f.1}\" }")
      }
      buf.write_string("]\n")
    }
  }
  buf.to_string()
}


///|
fn n3_dump_trans(trans : Array[N3TransDef]) -> String {
  if trans.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\{n3_banner3("# 6. 转换规则（Transitions）")}\n")
  for r in trans {
    buf.write_string("\n[[transitions]]\n")
    buf.write_string("from = \"\{r.from_state}\"\n")
    buf.write_string("on = \"\{r.on_event}\"\n")
    buf.write_string("to = \"\{r.to_state}\"\n")
    match r.action {
      Some(a) => buf.write_string("action = \"\{a}\"\n")
      None => ()
    }
    match r.guard_def {
      Some(g) => buf.write_string("guard_def = \"\{g}\"\n")
      None => ()
    }
    match r.effect {
      Some(e) => buf.write_string("effect = \"\{e}\"\n")
      None => ()
    }
    match r.assign {
      Some(a) => buf.write_string("assign = \"\{a}\"\n")
      None => ()
    }
    if r.action_args.is_empty() == false {
      buf.write_string("action_args = [")
      for i, a in r.action_args {
        if i > 0 {
          buf.write_string(", ")
        }
        buf.write_string("\"\{a}\"")
      }
      buf.write_string("]\n")
    }
    if r.requires.is_empty() == false {
      buf.write_string("requires = [")
      for i, q in r.requires {
        if i > 0 {
          buf.write_string(", ")
        }
        buf.write_string("\"\{q}\"")
      }
      buf.write_string("]\n")
    }
  }
  buf.to_string()
}

///|
fn n3_dump_chains(chains : Array[N3ChainDef]) -> String {
  if chains.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string(
    "\{n3_banner3("# 9. 收拾链（Scope Chains）：每个变体显式列出\"清谁\"，未列字段一律保留")}\n",
  )
  for c in chains {
    buf.write_string("\n[[scope_chains]]\n")
    buf.write_string("enum = \"\{c.enum_name}\"\n")
    buf.write_string("variant = \"\{c.variant}\"\n")
    buf.write_string("resets = [")
    for j, r in c.resets {
      if j > 0 {
        buf.write_string(", ")
      }
      buf.write_string("\"\{r}\"")
    }
    buf.write_string("]\n")
    match c.doc {
      Some(d) => buf.write_string("doc = \"\{d}\"\n")
      None => ()
    }
  }
  buf.to_string()
}


///|
/// 声明面动作：按名排序发射（镜像 domain_to_ir 排序口径；源序门见 validate）
fn n3_dump_actions(actions : Array[N3TraitAction]) -> String {
  if actions.is_empty() {
    return ""
  }
  let sorted : Array[N3TraitAction] = []
  for a in actions {
    sorted.push(a)
  }
  sorted.sort_by(fn(a, b) { n3_str_cmp(a.name, b.name) })
  let buf = StringBuilder()
  buf.write_string(
    "\{n3_banner3("# 10. 声明面动作（Trait Actions）：engine 直接调用，不走转移表")}\n",
  )
  for a in sorted {
    buf.write_string("\n[[actions]]\n")
    buf.write_string("name = \"\{a.name}\"\n")
    buf.write_string("params = [")
    for i, p in a.params {
      if i > 0 {
        buf.write_string(", ")
      }
      buf.write_string("\"\{p}\"")
    }
    buf.write_string("]\n")
    match a.comment {
      Some(c) => buf.write_string("comment = \"\{c}\"\n")
      None => ()
    }
  }
  buf.to_string()
}

///|
fn n3_dump_context(base : N3BaseDef) -> String {
  if base.fields.is_empty() && base.extras.is_empty() {
    return ""
  }
  let buf = StringBuilder()
  buf.write_string("\{n3_banner3("# 7. 上下文/字段定义（Context）")}\n")
  buf.write_string("\n[context]\n")
  if base.frame_fields.is_empty() == false {
    buf.write_string("frame_fields = [")
    for i, f in base.frame_fields {
      if i > 0 {
        buf.write_string(", ")
      }
      buf.write_string("\"\{f}\"")
    }
    buf.write_string("]\n")
  }
  buf.write_string("\nfields = [\n")
  for f in base.fields {
    buf.write_string("  { name = \"\{f.name}\", type = \"\{f.type_}\"")
    match f.default {
      Some(d) => buf.write_string(", default = \"\{d}\"")
      None => ()
    }
    buf.write_string(" },\n")
  }
  buf.write_string("]\n")
  for x in base.extras {
    buf.write_string("\n[[context.snapshot_extras]]\n")
    buf.write_string("name = \"\{x.name}\"\n")
    buf.write_string("type = \"\{x.type_}\"\n")
    buf.write_string("expr = \"\{x.expr}\"\n")
    match x.reset {
      Some(r) => buf.write_string("reset = \"\{r}\"\n")
      None => ()
    }
    match x.comment {
      Some(c) => buf.write_string("comment = \"\{c}\"\n")
      None => ()
    }
  }
  buf.to_string()
}

///|
/// 拼装（镜像 compile_domain_to_fsm_toml 的 parts+join 口径：空段跳过、末尾保证换行）
pub fn n3gen_dump(base : N3BaseDef, trans : Array[N3TransDef]) -> String {
  let parts : Array[String] = []
  parts.push(n3_dump_meta(base))
  parts.push(n3_dump_dialect(base))
  parts.push(n3_dump_events(base.events))
  parts.push(n3_dump_states(base.states))
  parts.push(n3_dump_effects(base.effects))
  parts.push(n3_dump_trans(trans))
  parts.push(n3_dump_chains(base.chains))
  parts.push(n3_dump_actions(base.actions))
  parts.push(n3_dump_context(base))
  let buf = StringBuilder()
  for part in parts {
    if part != "" && part != "\n" {
      buf.write_string(part)
      if !part.has_suffix("\n") {
        buf.write_string("\n")
      }
    }
  }
  buf.to_string()
}

///|
/// 编译入口：parse → validate → dump
pub fn n3gen_compile(
  base_src : String,
  trans_src : String,
) -> Result[String, String] {
  let base = match n3gen_parse_base(base_src) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let trans = match n3gen_parse_trans(trans_src) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match n3gen_validate(base, trans) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  Ok(n3gen_dump(base, trans))
}
