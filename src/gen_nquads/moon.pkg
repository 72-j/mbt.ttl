// gen_nquads：skelgen 生成器产物 + 装配层补充部分（词法器/Actions 回调/主循环/SliceParser）
// 词法器复用装配层收录的 lexer_mbt.mbt（Lexermoon；Token 与 C 版 Lexerc 同型同宽）
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/bench",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
} for "wbtest"

options(
  "is-main": false,
  "native-stub": [ "lexerc_ffi.c" ],
  targets: {
    // C FFI 词法器仅 native；用到它的文件与白盒测试同样限制
    "lexerc.mbt": [ "native" ],
    "engine_c.mbt": [ "native" ],
    "nquads_wbtest.mbt": [ "native" ],
    "nquads_bench_wbtest.mbt": [ "native" ],
    "lexer_bench_wbtest.mbt": [ "native" ],
    "lexerc_parity_wbtest.mbt": [ "native" ],
    // 后缀系 wbtest 走 @fs 读语料/基准件——wasm-gc/js 后端 async/fs 无文件 API,
    // 两面摘除;生产面全后端不设限(2026-11-03 平台 check wasm-gc/js 腿实测修复)
    "p2_bench_wbtest.mbt": [ "native", "wasm" ],
    "p3_probe_wbtest.mbt": [ "native", "wasm" ],
    "rdf_suite_wbtest.mbt": [ "native", "wasm" ],
    "validate_bench_wbtest.mbt": [ "native", "wasm" ],
  },
)
