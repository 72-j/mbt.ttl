///|
/// FSM Driver（mutable）：接收事件，原地推进 ctx，返回副作用意图或错误
/// ctx 提供状态（mut，state 由本函数独占写入），event 提供数据，actions 提供逻辑
pub fn[A : NQuadsActions] step(
  ctx : NQuadsContext,
  event : NQuadsEvent,
  actions : A,
) -> Result[NQuadsEffect, NQuadsActionError] {
  match (ctx.state, event) {
    (NQuadsExpectSubject, NQuadsIri(payload)) => {
      ctx.state = NQuadsExpectPredicate
      actions.set_subject(ctx, payload)
    }
    (NQuadsExpectSubject, NQuadsBlankNode(payload)) => {
      ctx.state = NQuadsExpectPredicate
      actions.set_subject(ctx, payload)
    }
    (NQuadsExpectPredicate, NQuadsIri(payload)) => {
      ctx.state = NQuadsExpectObject
      actions.set_predicate(ctx, payload)
    }
    (NQuadsExpectObject, NQuadsIri(payload)) => {
      ctx.state = NQuadsExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (NQuadsExpectObject, NQuadsBlankNode(payload)) => {
      ctx.state = NQuadsExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (NQuadsExpectObject, NQuadsLiteral(payload)) => {
      ctx.state = NQuadsExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (NQuadsExpectObject, NQuadsTripleTerm(payload)) => {
      ctx.state = NQuadsExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (NQuadsExpectDotOrGraph, NQuadsIri(payload)) => {
      ctx.state = NQuadsExpectDot
      actions.set_graph(ctx, payload)
    }
    (NQuadsExpectDotOrGraph, NQuadsBlankNode(payload)) => {
      ctx.state = NQuadsExpectDot
      actions.set_graph(ctx, payload)
    }
    (NQuadsExpectDotOrGraph, NQuadsDot) => {
      ctx.state = NQuadsExpectSubject
      Ok(NQuadsEffect::EmitQuad(ResetScope::All))
    }
    (NQuadsExpectDotOrGraph, NQuadsComma) => {
      ctx.state = NQuadsExpectObject
      Ok(NQuadsEffect::EmitQuad(ResetScope::Object))
    }
    (NQuadsExpectDotOrGraph, NQuadsSemicolon) => {
      ctx.state = NQuadsExpectPredicate
      Ok(NQuadsEffect::EmitQuad(ResetScope::PredObj))
    }
    (NQuadsExpectDotOrGraph, NQuadsUnknown) => {
      ctx.state = NQuadsExpectSubject
      Ok(NQuadsEffect::EmitQuad(ResetScope::All))
    }
    (NQuadsExpectDot, NQuadsDot) => {
      ctx.state = NQuadsExpectSubject
      Ok(NQuadsEffect::EmitQuad(ResetScope::All))
    }
    (_, _) => Err(NQuadsActionError::UnexpectedEvent(ctx.state, event))
  }
}


