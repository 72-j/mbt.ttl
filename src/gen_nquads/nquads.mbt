  Object // 清 object；保留 subject/predicate/graph
  PredObj // 清 predicate/object；保留 subject/graph
  SPO // 清 subject/predicate/object；保留 graph（TriG 图块口径）
  All // 清 subject/predicate/object/graph（N-Quads 行口径）
} derive(Debug)


