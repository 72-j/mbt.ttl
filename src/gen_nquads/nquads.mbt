    ResetScope::PredObj => {
      self.predicate = None
      self.object = None
    }
    ResetScope::SPO => {
      self.subject = None
      self.predicate = None
      self.object = None
    }
    ResetScope::All => {
      self.subject = None
      self.predicate = None
      self.object = None
      self.graph = None
    }
