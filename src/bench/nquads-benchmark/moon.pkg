import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "thy1016/moonttl/gen_nquads" @nquads,
}

// 第一段计时对照 C FFI 词法器（@nquads.Lexerc，native-only）；
// 计时基准只在 native 上有意义（wasm/js 量到的是宿主开销）——整包钉 native。
// 因此本包没有 canonical（wasm）接口：不保留 pkg.generated.mbti
// （native-only 包 moon info 会跳过，留一份只会是错路径的僵尸文件）。

supported_targets = "native"

pkgtype(kind: "executable")
