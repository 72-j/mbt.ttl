// gen_trig：skelgen 生成器产物（trig.mbt）+ 装配层补充部分（词法器/Actions 回调/主循环/SliceParser）
// 词法器复用装配层收录的 lexer_mbt.mbt（Tokenizer/Tokenfast）
import {
  "moonbitlang/core/debug",
  // "moonbitlang/core/array",
  "moonbitlang/core/encoding/utf8",
  "thy1016/moonttl/gen_nquads" @nquads,
  "thy1016/moonttl/gen_shared" @gs,
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/bench",
} for "wbtest"

options(
  targets: {
    // trig_bench 对照 C FFI 词法器（@nquads.Lexerc），仅 native
    "trig_bench_wbtest.mbt": [ "native" ],
    // rdf_suite_wbtest 走 @fs 读语料——wasm-gc/js 后端 async/fs 无文件 API,
    // 两面摘除;生产面全后端不设限(2026-11-03 平台 check wasm-gc/js 腿实测修复)
    "rdf_suite_wbtest.mbt": [ "native", "wasm" ],
  },
)
