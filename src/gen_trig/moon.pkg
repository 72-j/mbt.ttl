// gen_trig：fsm 生成器产物（trig.mbt）+ 装配层补充部分（词法器/Actions 回调/主循环/SliceParser）
// 词法器复用装配层收录的 lexer_mbt.mbt（Tokenizer/Tokenfast）
import {
  "moonbitlang/core/debug",
  // "moonbitlang/core/array",
  "moonbitlang/core/encoding/utf8",
  "thy1016/moonttl/gen_nquads" @nquads,
  "thy1016/moonttl/gen_shared" @gs,
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/bench",
} for "wbtest"

options(
  // trig_bench 对照 C FFI 词法器（@nquads.Lexerc），仅 native
  targets: { "trig_bench_wbtest.mbt": [ "native" ] },
)
