      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectObject, TrigBlankNode(payload)) => {
      ctx.state = TrigGraphExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectObject, TrigLiteral(payload)) => {
      ctx.state = TrigGraphExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectObject, TrigPrefName(payload)) => {
      ctx.state = TrigGraphExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectObject, TrigTripleTerm(payload)) => {
      ctx.state = TrigGraphExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectObject, TrigBracketTripleTerm(payload)) => {
      ctx.state = TrigGraphExpectDotOrGraph
      actions.set_object(ctx, payload)
    }
    (TrigGraphExpectDotOrGraph, TrigComma) => {
      ctx.state = TrigGraphExpectObject
      Ok(TrigEffect::EmitQuad(ResetScope::Object))
    }
    (TrigGraphExpectDotOrGraph, TrigSemicolon) => {
      ctx.state = TrigGraphExpectVerbOrEnd
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigGraphExpectDotOrGraph, TrigDot) => {
      ctx.state = TrigGraphExpectSubject
      Ok(TrigEffect::EmitQuad(ResetScope::SPO))
    }
    (TrigGraphExpectDotOrGraph, TrigTilde) => {
      ctx.state = TrigGraphExpectTildeEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphExpectDotOrGraph, TrigAnnotStart) => {
      ctx.state = TrigGraphAnnotExpectVerb
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigGraphExpectDotOrGraph, TrigRbrace) => {
      ctx.state = TrigExpectSubject
      Ok(TrigEffect::Sequence([TrigEffect::EmitQuad(ResetScope::SPO), TrigEffect::ExitGraph]))
    }
    (TrigGraphExpectVerbOrEnd, TrigIri(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrEnd, TrigPrefName(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrEnd, TrigKeywordA(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrEnd, TrigSemicolon) => {
      ctx.state = TrigGraphExpectVerbOrEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphExpectVerbOrEnd, TrigDot) => {
      ctx.state = TrigGraphExpectSubject
      Ok(TrigEffect::Reset(ResetScope::SPO))
    }
    (TrigGraphExpectVerbOrEnd, TrigRbrace) => {
      ctx.state = TrigExpectSubject
      Ok(TrigEffect::Reset(ResetScope::All))
    }
    (TrigGraphExpectVerbOrDot, TrigIri(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrDot, TrigPrefName(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrDot, TrigKeywordA(payload)) => {
      ctx.state = TrigGraphExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphExpectVerbOrDot, TrigDot) => {
      ctx.state = TrigGraphExpectSubject
      Ok(TrigEffect::EmitQuad(ResetScope::SPO))
    }
    (TrigGraphExpectVerbOrDot, TrigRbrace) => {
      ctx.state = TrigExpectSubject
      Ok(TrigEffect::Reset(ResetScope::All))
    }
    (TrigGraphExpectTildeEnd, TrigIri(_)) => {
      ctx.state = TrigGraphExpectTildeEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphExpectTildeEnd, TrigPrefName(_)) => {
      ctx.state = TrigGraphExpectTildeEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphExpectTildeEnd, TrigBlankNode(_)) => {
      ctx.state = TrigGraphExpectTildeEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphExpectTildeEnd, TrigDot) => {
      ctx.state = TrigGraphExpectSubject
      Ok(TrigEffect::EmitQuad(ResetScope::SPO))
    }
    (TrigGraphExpectTildeEnd, TrigSemicolon) => {
      ctx.state = TrigGraphExpectVerbOrEnd
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigGraphExpectTildeEnd, TrigComma) => {
      ctx.state = TrigGraphExpectObject
      Ok(TrigEffect::EmitQuad(ResetScope::Object))
    }
    (TrigGraphExpectTildeEnd, TrigAnnotStart) => {
      ctx.state = TrigGraphAnnotExpectVerb
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigGraphExpectTildeEnd, TrigRbrace) => {
      ctx.state = TrigExpectSubject
      Ok(TrigEffect::Sequence([TrigEffect::EmitQuad(ResetScope::SPO), TrigEffect::ExitGraph]))
    }
    (TrigGraphAnnotExpectVerb, TrigIri(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerb, TrigPrefName(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerb, TrigKeywordA(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerb, TrigSemicolon) => {
      ctx.state = TrigGraphAnnotExpectVerbTail
      Ok(TrigEffect::Continue)
    }
    (TrigGraphAnnotExpectVerbTail, TrigIri(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerbTail, TrigPrefName(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerbTail, TrigKeywordA(payload)) => {
      ctx.state = TrigGraphAnnotExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigGraphAnnotExpectVerbTail, TrigSemicolon) => {
      ctx.state = TrigGraphAnnotExpectVerbTail
      Ok(TrigEffect::Continue)
    }
    (TrigGraphAnnotExpectVerbTail, TrigAnnotEnd) => {
      ctx.state = TrigGraphExpectVerbOrEnd
      Ok(TrigEffect::Continue)
    }
    (TrigGraphAnnotExpectObject, TrigIri(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigBlankNode(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigLiteral(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigPrefName(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigTripleTerm(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigBracketTripleTerm(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectObject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, false, TrigGraphAnnotExpectEnd)
    }
    (TrigGraphAnnotExpectObject, TrigAnon(payload)) => {
      ctx.state = TrigGraphAnnotExpectEnd
      actions.set_object(ctx, payload)
    }
    (TrigGraphAnnotExpectEnd, TrigComma) => {
      ctx.state = TrigGraphAnnotExpectObject
      Ok(TrigEffect::EmitQuad(ResetScope::Object))
    }
    (TrigGraphAnnotExpectEnd, TrigSemicolon) => {
      ctx.state = TrigGraphAnnotExpectVerbTail
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigGraphAnnotExpectEnd, TrigAnnotEnd) => {
      ctx.state = TrigGraphExpectVerbOrEnd
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigBnpExpectPredicate, TrigRbracket) => {
      ctx.state = TrigBnpExpectPredicate
      Ok(TrigEffect::PopBnp)
    }
    (TrigBnpExpectPredicate, TrigIri(payload)) => {
      ctx.state = TrigBnpExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigBnpExpectPredicate, TrigPrefName(payload)) => {
      ctx.state = TrigBnpExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigBnpExpectPredicate, TrigKeywordA(payload)) => {
      ctx.state = TrigBnpExpectObject
      actions.set_predicate(ctx, payload)
    }
    (TrigBnpExpectObject, TrigIri(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigBlankNode(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigLiteral(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigPrefName(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigTripleTerm(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigBracketTripleTerm(payload)) => {
      ctx.state = TrigBnpAfterObject
      actions.set_object(ctx, payload)
    }
    (TrigBnpExpectObject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, false, TrigBnpAfterObject)
    }
    (TrigBnpAfterObject, TrigComma) => {
      ctx.state = TrigBnpExpectObject
      Ok(TrigEffect::EmitQuad(ResetScope::Object))
    }
    (TrigBnpAfterObject, TrigSemicolon) => {
      ctx.state = TrigBnpExpectPredicate
      Ok(TrigEffect::EmitQuad(ResetScope::PredObj))
    }
    (TrigBnpAfterObject, TrigRbracket) => {
      ctx.state = TrigBnpAfterObject
      Ok(TrigEffect::Sequence([TrigEffect::EmitQuad(ResetScope::PredObj), TrigEffect::PopBnp]))
    }
    (TrigExpectSubject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, true, TrigExpectVerbOrDot)
    }
    (TrigExpectSubject, TrigAnon(payload)) => {
      ctx.state = TrigExpectPredicate
      actions.set_subject(ctx, payload)
    }
    (TrigExpectDirectiveEnd, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, true, TrigExpectVerbOrDot)
    }
    (TrigExpectDirectiveEnd, TrigAnon(payload)) => {
      ctx.state = TrigExpectPredicate
      actions.set_subject(ctx, payload)
    }
    (TrigExpectDirectiveEnd, TrigTripleTerm(payload)) => {
      ctx.state = TrigExpectVerbOrDot
      actions.set_subject(ctx, payload)
    }
    (TrigExpectObject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, false, TrigExpectDotOrGraph)
    }
    (TrigGraphExpectSubject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, true, TrigGraphExpectVerbOrDot)
    }
    (TrigGraphExpectSubject, TrigAnon(payload)) => {
      ctx.state = TrigGraphExpectPredicate
      actions.set_subject(ctx, payload)
    }
    (TrigGraphExpectObject, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.open_bnode_prop(ctx, payload, false, TrigGraphExpectDotOrGraph)
    }
    (TrigListExpectElemOrEnd, TrigIri(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigBlankNode(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigLiteral(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigPrefName(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigTripleTerm(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigBracketTripleTerm(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigAnon(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_first(ctx, payload)
    }
    (TrigListExpectElemOrEnd, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.list_first_nested(ctx, payload, SlotType::BnodeProp, TrigListAfterElem)
    }
    (TrigListExpectElemOrEnd, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.list_first_nested(ctx, payload, SlotType::List, TrigListAfterElem)
    }
    (TrigListExpectElemOrEnd, TrigRparen) => {
      ctx.state = TrigListExpectElemOrEnd
      Ok(TrigEffect::PopBnp)
    }
    (TrigListAfterElem, TrigIri(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigBlankNode(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigLiteral(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigPrefName(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigTripleTerm(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigBracketTripleTerm(payload)) => {
      ctx.state = TrigListAfterElem
      actions.list_next(ctx, payload)
    }
    (TrigListAfterElem, TrigLbracket(payload)) => {
      ctx.state = TrigBnpExpectPredicate
      actions.list_next_nested(ctx, payload, SlotType::BnodeProp, TrigListAfterElem)
    }
    (TrigListAfterElem, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.list_next_nested(ctx, payload, SlotType::List, TrigListAfterElem)
    }
    (TrigListAfterElem, TrigRparen) => {
      ctx.state = TrigListAfterElem
      actions.list_nil(ctx)
    }
    (TrigExpectSubject, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, true, TrigExpectVerbRequired)
    }
    (TrigExpectDirectiveEnd, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, true, TrigExpectVerbRequired)
    }
    (TrigExpectObject, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, false, TrigExpectDotOrGraph)
    }
    (TrigGraphExpectSubject, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, true, TrigGraphExpectPredicate)
    }
    (TrigGraphExpectObject, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, false, TrigGraphExpectDotOrGraph)
    }
    (TrigBnpExpectObject, TrigLparen(payload)) => {
      ctx.state = TrigListExpectElemOrEnd
      actions.open_collection(ctx, payload, false, TrigBnpAfterObject)
    }
    (_, _) => Err(TrigActionError::UnexpectedEvent(ctx.state, event))
  }
}


///|
/// 副作用执行阶段的错误（第二层）
pub(all) enum TrigEffectError {
  SinkFailed(String) // 下游写入失败（可恢复）
  Fatal(String) // 致命错误，需要终止状态机
}


///|
/// 第二层 EffectHandler：真正的 match effect 发生在 step 外部
/// handle_* 模板方法默认 Ok(())；dispatch 默认解构意图并分发
/// 用户 impl 覆盖需要的 handle_*，通常无需覆盖 dispatch
pub trait TrigEffectHandler {
  fn handle_continue(Self) -> Result[Unit, TrigEffectError] = _
  fn handle_emit_quad(Self, ResetScope) -> Result[Unit, TrigEffectError] = _
  fn handle_reset(Self, ResetScope) -> Result[Unit, TrigEffectError] = _
  fn handle_done(Self) -> Result[Unit, TrigEffectError] = _
  fn handle_enter_graph(Self) -> Result[Unit, TrigEffectError] = _
  fn handle_exit_graph(Self) -> Result[Unit, TrigEffectError] = _
  fn handle_sequence(Self, Array[TrigEffect]) -> Result[Unit, TrigEffectError] = _
  fn handle_pop_bnp(Self) -> Result[Unit, TrigEffectError] = _
  fn handle_list_step(Self, Span) -> Result[Unit, TrigEffectError] = _
  fn handle_open_slot(Self, Span, SlotType, TrigState) -> Result[Unit, TrigEffectError] = _
  // —— 用户补充面：组装机械（业务落点，必须实现）——
  fn snapshot(Self, ctx : TrigContext) -> TrigPendingQuad
  fn apply_scope(Self, ctx : TrigContext, scope : ResetScope) -> Unit = _
  fn on_exit_graph(Self) -> Unit = _
  fn on_pop_bnp(Self, ctx : TrigContext) -> Unit = _
  fn on_list_step(Self, ctx : TrigContext, elem : Span) -> Unit = _
  fn on_open_slot(Self, ctx : TrigContext, span : Span, typ : SlotType, ret_state : TrigState) -> Unit = _
  // —— 模板面：interpret 默认实现（TrigEngine::next 解释序同源抽取）——
  fn interpret(Self, ctx : TrigContext, effect : TrigEffect) -> TrigEffectOutcome = _
  fn dispatch(Self, effect : TrigEffect) -> Result[Unit, TrigEffectError] = _
}

/// handle_continue 模板默认：无操作
impl TrigEffectHandler with fn handle_continue(_self) {
  Ok(())
}

/// handle_emit_quad 模板默认：无操作
impl TrigEffectHandler with fn handle_emit_quad(_self, _scope) {
  Ok(())
}

/// handle_reset 模板默认：无操作
impl TrigEffectHandler with fn handle_reset(_self, _scope) {
  Ok(())
}

/// handle_done 模板默认：无操作
impl TrigEffectHandler with fn handle_done(_self) {
  Ok(())
}

/// handle_enter_graph 模板默认：无操作
impl TrigEffectHandler with fn handle_enter_graph(_self) {
  Ok(())
}

/// handle_exit_graph 模板默认：无操作
impl TrigEffectHandler with fn handle_exit_graph(_self) {
  Ok(())
}

/// handle_sequence 模板默认：无操作
impl TrigEffectHandler with fn handle_sequence(_self, _effects) {
  Ok(())
}

/// handle_pop_bnp 模板默认：无操作
impl TrigEffectHandler with fn handle_pop_bnp(_self) {
  Ok(())
}

/// handle_list_step 模板默认：无操作
impl TrigEffectHandler with fn handle_list_step(_self, _elem) {
  Ok(())
}

/// handle_open_slot 模板默认：无操作
impl TrigEffectHandler with fn handle_open_slot(_self, _span, _typ, _ret_state) {
  Ok(())
}

///|
/// 单个效果的解释结果（loop 级控制流意图）
pub(all) enum TrigEffectOutcome {
  KeepGoing // 无产出，继续循环
  YieldQuad(TrigPendingQuad) // 上抛一个组装好的 pending quad
  Stop // 终止循环
}

/// on_exit_graph 模板默认：Sequence 内嵌退图（无帧机械时无操作）
impl TrigEffectHandler with fn on_exit_graph(_self) {
  ()
}

/// on_pop_bnp 模板默认：Sequence 内嵌钩子（无帧机械时无操作）
impl TrigEffectHandler with fn on_pop_bnp(_self, _ctx) {
  ()
}

/// on_list_step 模板默认：Sequence 内嵌钩子（无帧机械时无操作）
impl TrigEffectHandler with fn on_list_step(_self, _ctx, _elem) {
  ()
}

/// on_open_slot 模板默认：Sequence 内嵌钩子（无帧机械时无操作）
impl TrigEffectHandler with fn on_open_slot(_self, _ctx, _span, _typ, _ret_state) {
  ()
}

/// apply_scope 模板默认：[[scope_chains]] 展开的收拾链
/// （逐字段清槽，粒度不碰 state——state 由转移表 to= 负责）
impl TrigEffectHandler with fn apply_scope(_self, ctx, scope) {
  match scope {
    ResetScope::Object => {
      ctx.object = None
    }
    ResetScope::PredObj => {
      ctx.predicate = None
      ctx.object = None
    }
    ResetScope::SPO => {
      ctx.subject = None
      ctx.predicate = None
      ctx.object = None
    }
    ResetScope::All => {
      ctx.subject = None
      ctx.predicate = None
      ctx.object = None
      ctx.graph = None
    }
  }
}

/// interpret 模板默认：TrigEngine::next 解释序的同源抽取。
/// 臂按语义分组发射；用户补充 snapshot / apply_scope 后即得完整解释器
impl TrigEffectHandler with fn interpret(self, ctx, effect) {
  match effect {
    TrigEffect::Continue => KeepGoing
    TrigEffect::EnterGraph | TrigEffect::ExitGraph | TrigEffect::PopBnp | TrigEffect::ListStep(_) | TrigEffect::OpenSlot(_, _, _) => KeepGoing
    TrigEffect::Reset(scope) => {
      self.apply_scope(ctx, scope)
      KeepGoing
    }
    TrigEffect::EmitQuad(scope) => {
      let pending = self.snapshot(ctx)
      self.apply_scope(ctx, scope)
      YieldQuad(pending)
    }
    TrigEffect::Sequence(effects) => {
      // 意图串列：顺序解释；emit 组装暂存后继续执行余下意图
      let mut pending : TrigPendingQuad? = None
      for sub in effects {
        match sub {
          TrigEffect::EmitQuad(scope) => {
            pending = Some(self.snapshot(ctx))
            self.apply_scope(ctx, scope)
          }
          TrigEffect::Reset(scope) => self.apply_scope(ctx, scope)
          TrigEffect::ExitGraph => self.on_exit_graph()
          TrigEffect::PopBnp => self.on_pop_bnp(ctx)
          TrigEffect::ListStep(elem) => self.on_list_step(ctx, elem)
          TrigEffect::OpenSlot(span, typ, ret_state) => self.on_open_slot(ctx, span, typ, ret_state)
          TrigEffect::Done => break
          _ => ()
        }
      }
      match pending {
        Some(q) => YieldQuad(q)
        None => KeepGoing
      }
    }
    TrigEffect::Done => Stop
  }
}

/// dispatch 模板默认：match effect 并分发到 handle_*
impl TrigEffectHandler with fn dispatch(self, effect) {
  match effect {
    Continue => self.handle_continue()
    EmitQuad(scope) => self.handle_emit_quad(scope)
    Reset(scope) => self.handle_reset(scope)
    Done => self.handle_done()
    EnterGraph => self.handle_enter_graph()
    ExitGraph => self.handle_exit_graph()
    Sequence(effects) => self.handle_sequence(effects)
    PopBnp => self.handle_pop_bnp()
    ListStep(elem) => self.handle_list_step(elem)
    OpenSlot(span, typ, ret_state) => self.handle_open_slot(span, typ, ret_state)
  }
}
