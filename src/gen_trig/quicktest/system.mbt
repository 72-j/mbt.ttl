///|
/// Effect → Response 归一化（源: [type_mapping].effect_maps; 意图化: 载荷=收拾粒度不进模型）
fn effect_to_response(
  effect : @trig.TrigEffect,
  ctx : @trig.TrigContext,
) -> Response {
  match effect {
    @trig.TrigEffect::Continue => Continue
    @trig.TrigEffect::EmitQuad(_) => EmitQuad(quad_from_ctx(ctx)) // 意图化: 载荷=收拾粒度, quad 从 ctx 快照组装
    @trig.TrigEffect::Reset(_) => Continue // 归一化: Reset → Continue
    @trig.TrigEffect::Done => Done
    @trig.TrigEffect::EnterGraph => Continue // 归一化: EnterGraph → Continue
    @trig.TrigEffect::ExitGraph => Continue // 归一化: ExitGraph → Continue
    @trig.TrigEffect::Sequence(_) => EmitQuad(quad_from_ctx(ctx)) // 归一化: Sequence → EmitQuad
    @trig.TrigEffect::PopBnp => Continue // 归一化: PopBnp → Continue
    @trig.TrigEffect::ListStep(_) => Continue // 归一化: ListStep → Continue
    @trig.TrigEffect::OpenSlot(_) => Continue // 归一化: OpenSlot → Continue
  }
}

///|
/// 引擎 Context → Quad（槽位 Span 解码为引用; 收拾粒度意图不进模型）
fn quad_from_ctx(ctx : @trig.TrigContext) -> Quad {
  Quad::{
    subject: ref_id_of(ctx.subject.unwrap()),
    predicate: ref_id_of(ctx.predicate.unwrap()),
    object: ref_id_of(ctx.object.unwrap()),
    graph: ctx.graph.map(ref_id_of),
  }
}

///|
/// System: 被测系统（引擎 Context, 跨命令保持）
struct System {
  mut ctx : @trig.TrigContext
}

///|
fn system_init() -> System {
  { ctx: @trig.TrigContext::new(), }
}

