    // --- ListExpectElemOrEnd ---
    (ListExpectElemOrEnd, Iri(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, BlankNode(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, Literal(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, PrefName(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, TripleTerm(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, BracketTripleTerm(_)) =>
      emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, Anon(_)) => emit_predobj(model, ListAfterElem)
    (ListExpectElemOrEnd, Lbracket(_)) =>
      emit_predobj(model, BnpExpectPredicate)
    (ListExpectElemOrEnd, Lparen(_)) => emit_predobj(model, ListExpectElemOrEnd)
    (ListExpectElemOrEnd, Rparen) => (model, Continue)
    // --- ListAfterElem ---
    (ListAfterElem, Iri(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, BlankNode(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, Literal(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, PrefName(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, TripleTerm(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, BracketTripleTerm(_)) => emit_predobj(model, ListAfterElem)
    (ListAfterElem, Lbracket(_)) => emit_predobj(model, BnpExpectPredicate)
    (ListAfterElem, Lparen(_)) => emit_predobj(model, ListExpectElemOrEnd)
    (ListAfterElem, Rparen) => emit_predobj(model, ListAfterElem)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 槽位更新辅助: subject（action set_subject）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_subject(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let subject = match ref_id(r) {
    Some(id) => Some(id)
    None => model.subject
  }
  { ..model, state: to, subject, }
}

///|
/// 槽位更新辅助: predicate（action set_predicate）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_predicate(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let predicate = match ref_id(r) {
    Some(id) => Some(id)
    None => model.predicate
  }
  { ..model, state: to, predicate, }
}

///|
/// 槽位更新辅助: object（action set_object）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_object(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let object = match ref_id(r) {
    Some(id) => Some(id)
    None => model.object
  }
  { ..model, state: to, object, }
}

///|
/// 发射四元组: 槽位齐全 → EmitQuad 并按 Object 清槽; 不齐 → Error(1)
fn emit_object(model : Model, to : ModelState) -> (Model, Response) {
  if quad_ready(model) {
    let quad = take_quad(model)
    ({ ..model, state: to, object: None, }, EmitQuad(quad))
  } else {
    (model, Error(1)) // 不完整三元组
  }
}

///|
/// 发射四元组: 槽位齐全 → EmitQuad 并按 PredObj 清槽; 不齐 → Error(1)
fn emit_predobj(model : Model, to : ModelState) -> (Model, Response) {
  if quad_ready(model) {
    let quad = take_quad(model)
    ({ ..model, state: to, predicate: None, object: None, }, EmitQuad(quad))
  } else {
    (model, Error(1)) // 不完整三元组
  }
}

///|
/// 发射四元组: 槽位齐全 → EmitQuad 并按 SPO 清槽; 不齐 → Error(1)
fn emit_spo(model : Model, to : ModelState) -> (Model, Response) {
  if quad_ready(model) {
    let quad = take_quad(model)
    (
      { ..model, state: to, subject: None, predicate: None, object: None, },
      EmitQuad(quad),
    )
  } else {
    (model, Error(1)) // 不完整三元组
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "trig_quick_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, Literal(Concrete({ id: 1, })))
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, Literal(Concrete({ id: 1, })), Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Iri(Concrete({ id: 1, })), Continue)
  assert_true(t_ok != m)
}

///|
test "trig_quick_machine model_exec: EmitQuad 发射路径与缺槽兜底" {
  // 发射路径: 槽位齐全 → EmitQuad; 缺槽 → Error(1)
  let ready = {
    ..model_empty(),
    state: ExpectDotOrGraph,
    subject: Some({ id: 1, }),
    predicate: Some({ id: 2, }),
    object: Some({ id: 3, }),
  }
  let (m1, r1) = model_execute(ready, AnnotStart)
  assert_true(r1 is EmitQuad(_))
  assert_true(m1.predicate is None) // scope 清槽
  assert_true(m1.object is None) // scope 清槽
  let empty = { ..model_empty(), state: ExpectDotOrGraph, }
  let (m2, r2) = model_execute(empty, AnnotStart)
  assert_eq(r2, Error(1))
  assert_eq(m2, empty) // 模型保持
}
