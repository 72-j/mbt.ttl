/// 从槽位取**快照**载荷（快照档：槽位可空，照抄模型槽位；与引擎发射边界同口径）
fn take_quad(model : Model) -> Quad {
  Quad::{
    subject: model.subject,
    predicate: model.predicate,
    object: model.object,
    graph: model.graph,
  }
}

