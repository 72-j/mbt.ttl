      (set_object(model, r, GraphAnnotExpectEnd), Continue)
    (GraphAnnotExpectObject, Lbracket(r)) =>
      (
        frame_push(model, r, GraphAnnotExpectEnd, false, BnpExpectPredicate),
        Continue,
      )
    (GraphAnnotExpectObject, Anon(r)) =>
      (set_object(model, r, GraphAnnotExpectEnd), Continue)
    // --- GraphAnnotExpectEnd ---
    (GraphAnnotExpectEnd, Comma) => emit_object(model, GraphAnnotExpectObject)
    (GraphAnnotExpectEnd, Semicolon) =>
      emit_predobj(model, GraphAnnotExpectVerbTail)
    (GraphAnnotExpectEnd, AnnotEnd) => emit_predobj(model, GraphExpectVerbOrEnd)
    // --- BnpExpectPredicate ---
    (BnpExpectPredicate, Rbracket) => (frame_pop(model), Continue)
    (BnpExpectPredicate, Iri(r)) =>
      (set_predicate(model, r, BnpExpectObject), Continue)
    (BnpExpectPredicate, PrefName(r)) =>
      (set_predicate(model, r, BnpExpectObject), Continue)
    (BnpExpectPredicate, KeywordA(r)) =>
      (set_predicate(model, r, BnpExpectObject), Continue)
    // --- BnpExpectObject ---
    (BnpExpectObject, Iri(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, BlankNode(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, Literal(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, PrefName(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, TripleTerm(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, BracketTripleTerm(r)) =>
      (set_object(model, r, BnpAfterObject), Continue)
    (BnpExpectObject, Lbracket(r)) =>
      (
        frame_push(model, r, BnpAfterObject, false, BnpExpectPredicate),
        Continue,
      )
    (BnpExpectObject, Lparen(r)) =>
      (
        frame_push(model, r, BnpAfterObject, false, ListExpectElemOrEnd),
        Continue,
      )
    // --- BnpAfterObject ---
    (BnpAfterObject, Comma) => emit_object(model, BnpExpectObject)
    (BnpAfterObject, Semicolon) => emit_predobj(model, BnpExpectPredicate)
    // P4.2g：`Sequence([EmitQuad(PredObj), PopBnp])` —— 发射之后**弹帧**（帧的 ret_state 兑现 state）
    (BnpAfterObject, Rbracket) => {
      let (next, response) = emit_predobj(model, BnpAfterObject)
      (frame_pop(next), response)
    }
    // --- ListExpectElemOrEnd ---
    // P4.2h ①：`list_first` 写 `ctx.object = Some(elem)`（引擎 `actions.mbt:231`）
    //（`ctx.subject = Some((open_span.0, 1))` 只在 `node_seq == 0` 时写，且 RefId 与 `frame_push`
    // 已写的 subject 相同 ⇒ 模型不写；写了会在 `ret_state` 回程（node_seq ≠ 0）上出错）
    (ListExpectElemOrEnd, Iri(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, BlankNode(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, Literal(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, PrefName(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, TripleTerm(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, BracketTripleTerm(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    (ListExpectElemOrEnd, Anon(r)) =>
      emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListAfterElem,
      )
    // P4.2h 续：`list_first_nested` 的序列末段 `OpenSlot` ⇒ **压帧**（`as_subject=false`、
    // 不改状态）；`ret_state` 取该行 `action_args` 的 `state:ListAfterElem`（两种类型都同值）。
    (ListExpectElemOrEnd, Lbracket(r)) => {
      let (next, response) = emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        BnpExpectPredicate,
      )
      (frame_push(next, r, ListAfterElem, false, next.state), response)
    }
    (ListExpectElemOrEnd, Lparen(r)) => {
      let (next, response) = emit_predobj(
        {
          ..model,
          object: match ref_id(r) {
            Some(id) => Some(id)
            None => model.object
          },
        },
        ListExpectElemOrEnd,
      )
      (frame_push(next, r, ListAfterElem, false, next.state), response)
    }
    (ListExpectElemOrEnd, Rparen) => (frame_pop(model), Continue)
    // --- ListAfterElem ---
    // P4.2h ②：`list_next`/`_nested` 写 `ctx.object = Some((open_span.0, node_seq+1))`（`:280`）
    // ⇒ RefId 空间 = 帧的 `open_span`；序列中段 `ListStep(elem)` 再写 subject(=open_span)/object(=elem)。
    // **尾意图的第二条 `EmitQuad` 只能等 ③（harness 返 Array[Response]）**——现行一步一响应对不上。
    (ListAfterElem, Iri(r)) => list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, BlankNode(r)) => list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, Literal(r)) => list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, PrefName(r)) => list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, TripleTerm(r)) => list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, BracketTripleTerm(r)) =>
      list_next_arm(model, r, ListAfterElem)
    (ListAfterElem, Lbracket(r)) => list_next_arm(model, r, BnpExpectPredicate) // TODO(P0): 尾意图 EmitQuad/OpenSlot 待 ③
    (ListAfterElem, Lparen(r)) => list_next_arm(model, r, ListExpectElemOrEnd) // TODO(P0): 尾意图 EmitQuad/OpenSlot 待 ③
    // P4.2g + P4.2h：`list_nil` = `Sequence([EmitQuad(PredObj), PopBnp])`，且 `object = (open_span.0, 0)`
    // （`:331`；RefId 空间 = 帧的 `open_span`）⇒ 先写 object、发射、再弹帧。
    (ListAfterElem, Rparen) => {
      let (next, response) = emit_predobj(
        { ..model, object: Some(frame_open_span(model)), },
        ListAfterElem,
      )
      (frame_pop(next), response)
    }
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 槽位更新辅助: subject（action set_subject）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_subject(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let subject = match ref_id(r) {
    Some(id) => Some(id)
    None => model.subject
  }
  { ..model, state: to, subject, }
}

///|
/// 槽位更新辅助: predicate（action set_predicate）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_predicate(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let predicate = match ref_id(r) {
    Some(id) => Some(id)
    None => model.predicate
  }
  { ..model, state: to, predicate, }
}

///|
/// 槽位更新辅助: object（action set_object）
/// 目标态由调用臂传入（规则 to=），同一 action 的多目标复用由此消解
fn set_object(model : Model, r : @qcs.Ref[RefId], to : ModelState) -> Model {
  // 生成期 Symbolic 引用无法解析具体值: 槽位保持, 状态照常推进
  let object = match ref_id(r) {
    Some(id) => Some(id)
    None => model.object
  }
  { ..model, state: to, object, }
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 Object 清槽
/// （快照档：槽位可空与引擎发射边界同口径，模型不设前置判据——ADR-QM-009）
fn emit_object(model : Model, to : ModelState) -> (Model, Response) {
  let quad = take_quad(model)
  ({ ..model, state: to, object: None, }, EmitQuad(quad))
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 PredObj 清槽
/// （快照档：槽位可空与引擎发射边界同口径，模型不设前置判据——ADR-QM-009）
fn emit_predobj(model : Model, to : ModelState) -> (Model, Response) {
  let quad = take_quad(model)
  ({ ..model, state: to, predicate: None, object: None, }, EmitQuad(quad))
}

///|
/// 发射槽位快照: 无条件 EmitQuad(快照) 并按 SPO 清槽
/// （快照档：槽位可空与引擎发射边界同口径，模型不设前置判据——ADR-QM-009）
fn emit_spo(model : Model, to : ModelState) -> (Model, Response) {
  let quad = take_quad(model)
  (
    { ..model, state: to, subject: None, predicate: None, object: None, },
    EmitQuad(quad),
  )
}

///|
/// 帧栈顶 `open_span` 的 RefId（P4.2h）：list 族的**合成节点** `(open_span.0, k)`
/// 在 RefId 空间里就等于它（`RefId = span.0`）⇒ 模型不必建链、不必记序号。
/// 空栈兜底 = 哨兵 `RefId(0)`（与 `frame_push` 的符号期哨兵同口径）。
fn frame_open_span(model : Model) -> RefId {
  match model.frames.length() {
    0 => { id: 0, }
    _ => model.frames[model.frames.length() - 1].open_span
  }
}

///|
/// `list_next` / `list_next_nested` 的模型臂（P4.2h ②）：先写 `object = 帧 open_span`（合成节点），
/// 发射第一枚快照，再兑现序列中段 `ListStep(elem)`（subject = open_span、object = elem）。
/// **尾部的第二枚 EmitQuad / OpenSlot 待 ③**（harness 返 `Array[Response]`）——现行一步一响应
/// 表达不了"一步两发射"，故这里只复刻到第一条发射为止（漂移已被 ③ 立项钉住）。
fn list_next_arm(
  model : Model,
  r : @qcs.Ref[RefId],
  to : ModelState,
) -> (Model, Response) {
  let open = frame_open_span(model)
  let (next, response) = emit_predobj({ ..model, object: Some(open), }, to)
  let elem = match ref_id(r) {
    Some(id) => Some(id)
    None => next.object
  }
  let next1 = { ..next, subject: Some(open), object: elem, }
  // 序列末段 `OpenSlot`（P4.2h 续）：按 `SlotType` 压帧——引擎 `open_slot` 两分支都硬传
  // `as_subject = false`；**不改状态**（状态早由转移表 `to=` 定 ⇒ 传 `next1.state`）。
  (frame_push(next1, r, ListAfterElem, false, next1.state), response)
}

///|
/// 压帧（P4.2e）：记外层三槽快照 + `open_span` + `ret_state` + `as_subject`，
/// 再把 `subject = open_span`、`predicate = None`（与引擎 open_bnode_prop/open_collection 同机械）
fn frame_push(
  model : Model,
  open : @qcs.Ref[RefId],
  ret_state : ModelState,
  as_subject : Bool,
  to : ModelState,
) -> Model {
  // 符号期无具体值 ⇒ 哨兵 RefId(0)（结构期只需"有节点"；执行期解析真值）
  let open_span = match ref_id(open) {
    Some(id) => id
    None => { id: 0, }
  }
  let frames = model.frames.copy()
  frames.push({
    subject: model.subject,
    predicate: model.predicate,
    graph: model.graph,
    open_span,
    ret_state,
    as_subject,
  })
  // 状态由**转移表**给（`to`）；`ret_state` 只是压进帧、弹帧时才兑现
  { ..model, state: to, subject: Some(open_span), predicate: None, frames, }
}

///|
/// 弹帧（P4.2e）：恢复外层三槽 + **`state = ret_state`**（"状态由表管理"的唯一例外，
/// 引擎在 pop_bnode_prop 尾行兑现）；新节点引用取 `open_span`
/// （空表 `(open.0, 0)` 与 `open_span` 同 start ⇒ 同 RefId，故模型无需建链）。
fn frame_pop(model : Model) -> Model {
  // 纯函数口径：先 copy 再 pop——模型执行可能被调用两次（`transition` 会重跑
  let frames = model.frames.copy()
  match frames.pop() {
    Some(fr) => {
      let target = fr.open_span
      let subject = if fr.as_subject { Some(target) } else { fr.subject }
      let object = if fr.as_subject { model.object } else { Some(target) }
      {
        ..model,
        state: fr.ret_state,
        subject,
        predicate: fr.predicate,
        object,
        graph: fr.graph,
        frames,
      }
    }
    None => model
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "trig_quick_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, Literal(Concrete({ id: 1, })))
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, Literal(Concrete({ id: 1, })), Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Iri(Concrete({ id: 1, })), Continue)
  assert_true(t_ok != m)
}

///|
test "trig_quick_machine model_exec: EmitQuad 发射路径与空槽照发" {
  // 快照档（ADR-QM-009）：槽位不全也照发 —— 载荷 = 引擎发射边界的槽位快照
  let ready = {
    ..model_empty(),
    state: ExpectDotOrGraph,
    subject: Some({ id: 1, }),
    predicate: Some({ id: 2, }),
    object: Some({ id: 3, }),
    graph: Some({ id: 4, }),
  }
  let (m1, r1) = model_execute(ready, AnnotStart)
  assert_true(r1 is EmitQuad(_))
  assert_true(m1.predicate is None) // scope 清槽
  assert_true(m1.object is None) // scope 清槽
  // 空槽快照：仍发 EmitQuad（不设"槽位齐全"前置），状态照常推进
  let empty = { ..model_empty(), state: ExpectDotOrGraph, }
  let (m2, r2) = model_execute(empty, AnnotStart)
  assert_true(r2 is EmitQuad(_))
  assert_eq(m2.state, AnnotExpectVerb)
}
