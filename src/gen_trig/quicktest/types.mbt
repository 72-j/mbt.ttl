// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// ========================================
// 映射约定：
//   Event   → Command  （Span 载荷 → @qcs.Ref[RefId]，多载荷简化为单引用）
//   Effect  → Response （effect_maps 归一化；错误统一 Error(Int)；其余载荷不进模型）
//   Context → Model    （仅保留 Span 槽位字段，状态镜像为 ModelState）

///|
/// Span 的符号替身：生成期以 Symbolic(Var) 引用，执行期解析为 Concrete(RefId)
priv struct RefId {
  id : Int
} derive(Eq, Debug)

///|
/// Command - 测试命令类型（源: [[events]]）
priv enum Command {
  Iri(@qcs.Ref[RefId])
  BlankNode(@qcs.Ref[RefId])
  Literal(@qcs.Ref[RefId])
  PrefName(@qcs.Ref[RefId])
  TripleTerm(@qcs.Ref[RefId])
  BracketTripleTerm(@qcs.Ref[RefId])
  KeywordA(@qcs.Ref[RefId])
  At
  PrefixKw
  BaseKw
  GraphKw
  VersionKw
  Tilde
  AnnotStart
  AnnotEnd
  Comma
  Semicolon
  Dot
  Lbrace
  Rbrace
  Lbracket(@qcs.Ref[RefId])
  Rbracket
  Lparen(@qcs.Ref[RefId])
  Rparen
  Anon(@qcs.Ref[RefId])
  Bang
  Caret
  Implies
  ImpliedBy
  ForAllKw
  ForSomeKw
  KeywordsKw
  Unknown
  EOF
} derive(Eq, Debug)

///|
/// Quad - EmitQuad 载荷的模型表示（槽位引用；graph 可空 = 默认图）
priv struct Quad {
  subject : RefId
  predicate : RefId
  object : RefId
  graph : RefId?
} derive(Eq, Debug)

///|
/// Response - 测试响应类型（源: [[effects]] + 错误归一化）
priv enum Response {
  Continue
  EmitQuad(Quad)
  Done
  Error(Int) // 引擎错误归一化（[type_mapping].error_codes）
} derive(Eq, Debug)

///|
/// ModelState - 纯模型状态枚举（镜像引擎 State 枚举，独立于引擎包）
priv enum ModelState {
  ExpectSubject
  ExpectPredicate
  ExpectObject
  ExpectDotOrGraph
  ExpectDirectiveKind
  ExpectPrefixName
  ExpectPrefixIri
  ExpectBaseIri
  ExpectVersionLiteral
  ExpectDirectiveEnd
  ExpectGraphLabel
  ExpectGraphLbrace
  ExpectVerbOrEnd
  ExpectVerbOrDot
  ExpectVerbRequired
  ExpectTildeEnd
  AnnotExpectVerb
  AnnotExpectVerbTail
  AnnotExpectObject
  AnnotExpectEnd
  GraphAnnotExpectVerb
  GraphAnnotExpectVerbTail
  GraphAnnotExpectObject
  GraphAnnotExpectEnd
  GraphExpectSubject
  GraphExpectPredicate
  GraphExpectObject
  GraphExpectDotOrGraph
  GraphExpectVerbOrDot
  GraphExpectTildeEnd
  GraphExpectVerbOrEnd
  BnpExpectPredicate
  BnpExpectObject
  BnpAfterObject
  ListExpectElemOrEnd
  ListAfterElem
} derive(Eq, Debug)

///|
/// Model - 纯模型（源: Context 的 Span 槽位；规格而非被测实现）
priv struct Model {
  state : ModelState
  subject : RefId?
  predicate : RefId?
  object : RefId?
  graph : RefId?
} derive(Eq, Debug)
// 未进模型的 Context 字段: emit_queue (Array[TrigPendingQuad]), directive_at (Bool), prefixes (Array[(Span, Span)]), bases (Array[Span]), slot_stack (Array[Slot]), pred_kind (PredKind), subj_shell (Bool), annot_close (Bool)

///|
/// 初始模型：ExpectSubject，槽位全空
fn model_empty() -> Model {
  {
    state: ExpectSubject,
    subject: None,
    predicate: None,
    object: None,
    graph: None,
  }
}

///|
/// 符号引用取具体值：生成期 Symbolic 返回 None，执行期 Concrete 返回 Some
fn ref_id(reference : @qcs.Ref[RefId]) -> RefId? {
  match reference {
    Concrete(id) => Some(id)
    Symbolic(_) => None
  }
}

///|
test "trig_quick_machine types: model_empty / ref_id 冒烟" {
  // 初始模型与引用解包
  let model = model_empty()
  assert_eq(model.state, ExpectSubject)
  let concrete : @qcs.Ref[RefId] = Concrete({ id: 7, })
  assert_eq(ref_id(concrete), Some({ id: 7, }))
  let symbolic : @qcs.Ref[RefId] = Symbolic(@qcs.Var::{ id: 0, })
  assert_true(ref_id(symbolic) is None)
}
