// ===== 运行配置（源: [random_check]） =====

///|
fn quick_run_config() -> @qcs.RunConfig {
  {
    seed: 12345UL,
    cases: 100,
    max_commands: 20,
    size: 20,
    max_tries: 20,
    shrink: true,
    max_shrinks: 100,
    max_shrink_rounds: 20,
    required_labels: [],
    required_command_names: [],
  }
}

// ===== 固定脚本（源: [[assert_check]], 8 步） =====

///|
fn assert_script() -> Array[Command] {
  [
    Iri(Concrete({ id: 1, })),
    Iri(Concrete({ id: 2, })),
    Iri(Concrete({ id: 3, })),
    Dot,
    Iri(Concrete({ id: 4, })),
    Iri(Concrete({ id: 5, })),
    Iri(Concrete({ id: 6, })),
    Dot,
  ]
}

///|
/// 固定脚本检查: 失败即抛出（回归基准; 覆盖关键路径）
fn run_assert_check() -> @qcs.RunReport[Command, Response, Command, Response] raise {
  let script = assert_script()
  let config = { ..quick_run_config(), cases: 1, max_commands: 8, }
  @qcs.assert_check(quick_state_machine(script=Some(script)), config~)
}

///|
/// 固定脚本检查（P4.2b 接活）：回归基线，覆盖两条三元组语句
test "trig quick machine: assert check（固定脚本）" {
  let report = run_assert_check()
  assert_eq(report.commands_run, 8)
}

// ===== 覆盖率门（可达命令名取自 [[transitions]]）=====

///|
/// @qcs 的覆盖判定是**逐用例**的（任一用例缺 required 命令名即 CoverageFailed），
/// 故这里用**单条长用例**，而不是把要求挂到随机多用例上。
/// 只列**转移表里有出边**的命令名：无转移命令（valid 表兜底拒绝）列进去必然失败。
fn coverage_gate_config() -> @qcs.RunConfig {
  {
    ..quick_run_config(),
    cases: 1,
    max_commands: 200,
    required_labels: ["resp:Continue", "resp:EmitQuad"],
    required_command_names: [
      "Iri", "BlankNode", "Literal", "PrefName", "TripleTerm", "BracketTripleTerm",
      "KeywordA", "At", "PrefixKw", "BaseKw", "GraphKw", "VersionKw", "Tilde", "AnnotStart",
      "AnnotEnd", "Comma", "Semicolon", "Dot", "Lbrace", "Rbrace", "Lbracket", "Rbracket",
      "Lparen", "Rparen", "Anon",
    ],
  }
}

///|
/// 覆盖率门: 成功一次即可（覆盖要求由 config 判定）
fn run_coverage_check() -> Result[
  @qcs.RunReport[Command, Response, Command, Response],
  @qcs.RunFailure[Model, Model, Command, Command, Response, Response],
] {
  @qcs.check(quick_state_machine(), config=coverage_gate_config())
}
